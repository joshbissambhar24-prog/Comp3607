<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.uwi</groupId><artifactId>bluej-telemetry</artifactId><version>1.0.0</version><packaging>jar</packaging>
  <name>BlueJ Telemetry Analytics</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <bluej.jar>${project.basedir}/lib/bluej.jar</bluej.jar>
    <junit.version>5.11.4</junit.version>
  </properties>
  <dependencies>
    <!-- Copy the BlueJ installation's lib/bluej.jar to lib/bluej.jar (see README). Never bundle BlueJ classes. -->
    <dependency>
      <groupId>org.bluej</groupId><artifactId>bluej-api</artifactId><version>installed</version>
      <scope>system</scope><systemPath>${bluej.jar}</systemPath>
    </dependency>
    <!-- JavaFX is already provided at runtime by BlueJ. -->
    <dependency>
      <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>21.0.4</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration><useModulePath>false</useModulePath></configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.13</version>
        <!-- Measure pure Java data processing / report code, not the GUI-only adapter or sample demo. -->
        <configuration>
          <excludes>
            <exclude>edu/uwi/bluejtelemetry/bluej/**</exclude>
            <exclude>edu/uwi/bluejtelemetry/demo/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report-and-check</id><phase>verify</phase>
            <goals><goal>report</goal><goal>check</goal></goals>
            <configuration>
              <rules><rule><element>BUNDLE</element>
                <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit></limits>
              </rule></rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version>
        <configuration><archive><manifest><mainClass>edu.uwi.bluejtelemetry.bluej.BlueJTelemetryExtension</mainClass></manifest></archive></configuration>
      </plugin>
    </plugins>
  </build>
</project>
